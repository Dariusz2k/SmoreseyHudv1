<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GTagSpeedMod</AssemblyName>
    <RootNamespace>GTagSpeedMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- BepInEx Package References -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.5" />
  </ItemGroup>

  <!-- Reference local Unity/Game DLLs -->
  <!-- Note: Photon DLLs must be copied from Gorilla Tag installation -->
  <!-- Typically found in: [Gorilla Tag]\Gorilla Tag_Data\Managed\ -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\libs')">
    <Reference Include="Assembly-CSharp" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\Assembly-CSharp.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonRealtime" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\PhotonRealtime.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\PhotonRealtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Photon3Unity3D" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\Photon3Unity3D.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\Photon3Unity3D.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\PhotonUnityNetworking.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\PhotonUnityNetworking.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonVoice" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\PhotonVoice.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\PhotonVoice.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonVoice.API" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\PhotonVoice.API.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\PhotonVoice.API.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonVoice.PUN" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\PhotonVoice.PUN.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\PhotonVoice.PUN.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ExitGames.Client.Photon" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\ExitGames.Client.Photon.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\ExitGames.Client.Photon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonChat" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\PhotonChat.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\PhotonChat.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
