<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GTagSpeedMod</AssemblyName>
    <RootNamespace>GTagSpeedMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- BepInEx Package References -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.5" />
  </ItemGroup>

  <!-- Reference local Unity/Game DLLs if needed -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\libs')">
    <Reference Include="Assembly-CSharp" Condition="Exists('$(MSBuildThisFileDirectory)..\libs\Assembly-CSharp.dll')">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
